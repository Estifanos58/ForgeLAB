# ForgeLab Environment Variables
# Copy this file to .env and customize for your development environment.

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=forgelab
POSTGRES_PASSWORD=forgelab_dev_password
POSTGRES_DB=forgelab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://forgelab:forgelab_dev_password@localhost:5432/forgelab?sslmode=disable

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# ForgeLab Server
# ==========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# Authentication & Cookies
# ==========================================
# JWT signing secret — generate a strong random string for production
JWT_SECRET=forgelab-dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15
JWT_REFRESH_TOKEN_EXPIRY=7
COOKIE_SECURE=false

# ==========================================
# Google OAuth 2.0 (Authentication Only)
# ==========================================
# Obtain credentials from Google Cloud Console (OAuth 2.0 Client IDs for Web Application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=example-google-client-id
GOOGLE_CLIENT_SECRET=example-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# GitHub OAuth 2.0 (Authentication & Repositories)
# ==========================================
# Obtain credentials from GitHub Developer Settings (OAuth Apps)
# Sign-In Scopes requested: read:user, user:email
# Sign-In Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=example-github-client-id
GITHUB_CLIENT_SECRET=example-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/github/callback

# Repository Import callback URL (Dedicated flow, requests repo,read:user scopes):
# IMPORTANT: In GitHub Developer Settings, a GitHub OAuth App validates that the redirect_uri
# matches its configured "Authorization callback URL". If using a single GitHub OAuth App
# for both user sign-in and repository import, set the Authorization callback URL in GitHub
# Developer Settings to:
#   http://localhost:3000/api/integrations/github/callback
# Or register two separate OAuth Apps if you wish to have dedicated client IDs for each flow.
GITHUB_REPO_REDIRECT_URL=http://localhost:3000/api/integrations/github/callback

# ==========================================
# Encryption
# ==========================================
# AES-256 encryption key for secrets — 32 bytes, base64 encoded
FORGELAB_ENCRYPTION_KEY=dGhpcy1pcy1hLWRldi1rZXktY2hhbmdlLWluLXByb2Q=

# ==========================================
# Docker
# ==========================================
# Docker socket path (default auto-detected for Docker Desktop / Linux)
# DOCKER_HOST=unix:///var/run/docker.sock
FORGELAB_WORK_DIR=./data/builds
# Comma-separated list of allowed host paths for local directory imports (e.g. C:\Users\estif\Projects or /home/user/projects)
FORGELAB_ALLOWED_SOURCE_ROOTS=
# For containerized environments (Docker Compose): Host directory mounted into container at FORGELAB_CONTAINER_SOURCE_ROOT
# Windows example: FORGELAB_HOST_SOURCE_ROOT=C:\Users\estif\Projects
# Linux example: FORGELAB_HOST_SOURCE_ROOT=/home/user/projects
FORGELAB_HOST_SOURCE_ROOT=
FORGELAB_CONTAINER_SOURCE_ROOT=/host-projects
# Local build mode: "direct" (stream build context directly, zero duplication) or "snapshot" (copy before build)
FORGELAB_LOCAL_BUILD_MODE=direct

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=text
