# ForgeLab Environment Variables
# Copy this file to .env and fill in values

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=forgelab
POSTGRES_PASSWORD=forgelab_dev_password
POSTGRES_DB=forgelab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://forgelab:forgelab_dev_password@localhost:5432/forgelab?sslmode=disable

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# ForgeLab Server
# ==========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ==========================================
# Authentication
# ==========================================
# JWT signing secret — generate a strong random string for production
JWT_SECRET=forgelab-dev-jwt-secret-change-in-production

# Access token expiry (in minutes)
JWT_ACCESS_TOKEN_EXPIRY=15

# Refresh token expiry (in days)
JWT_REFRESH_TOKEN_EXPIRY=7

# ==========================================
# Encryption
# ==========================================
# AES-256 encryption key for secrets — 32 bytes, base64 encoded
# Generate with: openssl rand -base64 32
FORGELAB_ENCRYPTION_KEY=dGhpcy1pcy1hLWRldi1rZXktY2hhbmdlLWluLXByb2Q=

# ==========================================
# Docker
# ==========================================
# Docker socket path (default for Linux/Mac)
# DOCKER_HOST=unix:///var/run/docker.sock
# For Windows with Docker Desktop, usually auto-detected

# Working directory for deployment builds
FORGELAB_WORK_DIR=./data/builds

# Allowed host source root directories (comma-separated absolute paths)
# Limits where local repositories can be imported from on the host filesystem.
# If empty, boundary checking is bypassed, but system directories (/etc, C:\Windows, etc.)
# and symlink escapes remain strictly blocked by PathValidator.
# Windows example: FORGELAB_ALLOWED_SOURCE_ROOTS=C:\Users\developer\Projects,D:\Dev
# Linux/Mac example: FORGELAB_ALLOWED_SOURCE_ROOTS=/home/developer/projects,/opt/code
FORGELAB_ALLOWED_SOURCE_ROOTS=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
LOG_FORMAT=text
